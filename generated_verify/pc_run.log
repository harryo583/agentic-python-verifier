Capacity, MaxLen <- MaxLen, pc <- pcQ\nP == INSTANCE Producer_Impl WITH generated <- generated, next_item <- next_item, MaxItem <- MaxItem, MaxLen <- MaxLen, pc <- pcP\nC == INSTANCE Consumer_Impl WITH received <- received, sum <- sum, MaxLen <- MaxLen, pc <- pcC\n\nSpec == Q!Spec /\\ P!Spec /\\ C!Spec\n\nRECURSIVE SumSeq(_)\nSumSeq(s) == IF s = << >> THEN 0 ELSE Head(s) + SumSeq(Tail(s))\n\nIsPrefix(a, b) ==\n  /\\ Len(a) <= Len(b)\n  /\\ \\A i \\in 1..Len(a) : a[i] = b[i]\n\nBSeq(S) == UNION { [1..n -> S] : n \\in 0..MaxLen }\n\nInv ==\n  /\\ Q!Inv\n  /\\ P!Inv\n  /\\ C!Inv\n  /\\ buffer \\in BSeq(1..10)\n  /\\ generated \\in BSeq(1..MaxItem)\n  /\\ received \\in BSeq(1..MaxItem)\n  /\\ Len(buffer) \\in 0..Capacity\n  /\\ IsPrefix(received, generated)\n  /\\ next_item \\in 1..(MaxItem+1)\n\nProperty ==\n  /\\ Len(buffer) \\in 0..Capacity\n  /\\ IsPrefix(received, generated)\n  /\\ next_item <= MaxItem + 1\n\n====\n'}, 'modules': [{'name': 'BoundedQueue', 'role': 'abs', 'constants': {'values': {'Capacity': [3], 'MaxLen': [3]}}, 'tla_source': "---- MODULE BoundedQueue_Abs ----\nEXTENDS Naturals, Sequences\n\nCONSTANTS Capacity, MaxLen\n\nVARIABLE queue\n\nvars == << queue >>\n\nBSeq(S) == UNION { [1..n -> S] : n \\in 0..MaxLen }\n\nInit == queue = << >>\n\nEnqueue(v) ==\n  /\\ v \\in 1..10\n  /\\ Len(queue) < Capacity\n  /\\ queue' = Append(queue, v)\n\nDequeue ==\n  /\\ Len(queue) > 0\n  /\\ queue' = Tail(queue)\n\nNext == (\\E v \\in 1..10 : Enqueue(v)) \\/ Dequeue\n\nSpec == Init /\\ [][Next]_vars\n\nInv ==\n  /\\ queue \\in BSeq(1..10)\n  /\\ Len(queue) \\in 0..Capacity\n\n====\n"}, {'name': 'BoundedQueue', 'role': 'impl', 'constants': {'values': {'Capacity': [3], 'MaxLen': [3]}}, 'abstraction_map': {'queue': 'buffer'}, 'tla_source': '---- MODULE BoundedQueue_Impl ----\nEXTENDS Naturals, Sequences\n\nCONSTANTS Capacity, MaxLen\n\nBSeq(S) == UNION { [1..n -> S] : n \\in 0..MaxLen }\n\n(* --algorithm BoundedQueue\nvariables buffer = << >>;\nbegin\n  Loop:\n    while TRUE do\n      either\n        with v \\in 1..10 do\n          await Len(buffer) < Capacity;\n          buffer := Append(buffer, v);\n        end with;\n      or\n        await Len(buffer) > 0;\n        buffer := Tail(buffer);\n      end either;\n    end while;\nend algorithm; *)\n\nInv ==\n  /\\ buffer \\in BSeq(1..10)\n  /\\ Len(buffer) \\in 0..Capacity\n  /\\ pc \\in {"Loop", "Done"}\n\nProperty == Len(buffer) \\in 0..Capacity\n\n====\n', 'pluscal_source': 'x'}, {'name': 'Producer', 'role': 'abs', 'constants': {'values': {'MaxItem': [3], 'MaxLen': [3]}}, 'tla_source': "---- MODULE Producer_Abs ----\nEXTENDS Naturals, Sequences\n\nCONSTANTS MaxItem, MaxLen\n\nVARIABLES generated, next_item\n\nvars == << generated, next_item >>\n\nBSeq(S) == UNION { [1..n -> S] : n \\in 0..MaxLen }\n\nInit ==\n  /\\ generated = << >>\n  /\\ next_item = 1\n\nProduce ==\n  /\\ next_item <= MaxItem\n  /\\ generated' = Append(generated, next_item)\n  /\\ next_item' = next_item + 1\n\nNext == Produce \\/ (next_item > MaxItem /\\ UNCHANGED vars)\n\nSpec == Init /\\ [][Next]_vars\n\nInv ==\n  /\\ generated \\in BSeq(1..MaxItem)\n  /\\ next_item \\in 1..(MaxItem+1)\n  /\\ Len(generated) = next_item - 1\n  /\\ \\A i \\in 1..Len(generated) : generated[i] = i\n\n====\n"}, {'name': 'Producer', 'role': 'impl', 'constants': {'values': {'MaxItem': [3], 'MaxLen': [3]}}, 'abstraction_map': {'generated': 'generated', 'next_item': 'next_item'}, 'tla_source': '---- MODULE Producer_Impl ----\nEXTENDS Naturals, Sequences\n\nCONSTANTS MaxItem, MaxLen\n\nBSeq(S) == UNION { [1..n -> S] : n \\in 0..MaxLen }\n\n(* --algorithm Producer\nvariables generated = << >>, next_item = 1;\nbegin\n  Loop:\n    while next_item <= MaxItem do\n      generated := Append(generated, next_item);\n      next_item := next_item + 1;\n    end while;\nend algorithm; *)\n\nInv ==\n  /\\ generated \\in BSeq(1..MaxItem)\n  /\\ next_item \\in 1..(MaxItem+1)\n  /\\ Len(generated) = next_item - 1\n  /\\ \\A i \\in 1..Len(generated) :