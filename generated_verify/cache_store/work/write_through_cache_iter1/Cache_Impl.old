---- MODULE Cache_Impl ----
EXTENDS Naturals, TLC

CONSTANTS Keys, Vals, Missing

(* --algorithm Cache
variables
  cache = [k \in Keys |-> Missing];

begin
  Loop:
    while TRUE do
      either
        with k \in Keys, v \in Vals do
          cache[k] := v;
        end with;
